        {
          "id": "71a31214-efef-4308-a528-e326430231f8",
          "name": "Get Events",
          "request": {
            "name": "Get Events",
            "description": {
              "content": "Lists audit events for the caller's organization.\n\nResults are paginated. If more events are available, the response includes\n`pagination.next_page_token`; pass that token back unchanged to continue from\nthe last item you received.\n\nFilter by event type using the `event_type` query parameter. Pass one of the\nidentifiers returned by [`GET /api/events_types`](../../api-reference/events/get-types) to\nnarrow results to a specific category of activity.\n\n> 📘 Events reflect audit activity scoped to the caller's organization.\n> The log captures both user-initiated and API-initiated actions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "organization_id",
                  "value": "<uuid>",
                  "description": "Organization to list events for. Only used by system callers; normal and partner callers are always scoped to their own organization."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter to a single event type. Use GET /api/events_types to list valid values."
                },
                {
                  "disabled": false,
                  "key": "starting_after",
                  "value": "<dateTime>",
                  "description": "Return events created strictly after this timestamp."
                },
                {
                  "disabled": false,
                  "key": "ending_before",
                  "value": "<dateTime>",
                  "description": "Return events created strictly before this timestamp."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of events to return. Default 10, maximum 100."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "key": "X-Polytomic-Version",
                "value": "<string>",
                "description": ""
              },
              {
                "key": "Accept",
